---
interface Step {
  number: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    number: "01",
    title: "Encuentra",
    description: "Busca tu evento y entra a su galería.",
  },
  {
    number: "02",
    title: "Selecciona",
    description: "Toca las fotos que quieras comprar. Puedes añadir o quitar fotos de tu selección.",
  },
  {
    number: "03",
    title: "Compra",
    description: "Pulsa «Comprar seleccionadas» y te llevamos a WhatsApp con tus fotos ya identificadas.",
  },
];
---

<section class="how-to-buy" aria-labelledby="how-to-buy-title">
  <div class="how-to-buy__inner">
    <h2 class="how-to-buy__title" id="how-to-buy-title">Cómo<br />comprar</h2>

    <ol class="how-to-buy__list">
      {
        steps.map((step) => (
          <li class="how-to-buy__step">
            <span class="how-to-buy__number" aria-hidden="true">{step.number}</span>
            <h3 class="how-to-buy__step-title">{step.title}</h3>
            <p class="how-to-buy__description">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-to-buy {
    padding-block: 5rem;
    background: #cdff3a;
    color: var(--home-ink, var(--color-ink));
  }

  .how-to-buy__inner {
    display: grid;
    gap: 3rem;
    width: 100%;
    max-width: var(--container-max-width);
    padding-inline: var(--container-padding);
    margin-inline: auto;
  }

  .how-to-buy__title {
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .how-to-buy__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .how-to-buy__step {
    min-width: 0;
    padding-top: 1.125rem;
    border-top: 2px solid currentColor;
  }

  .how-to-buy__number {
    display: block;
    margin-bottom: 0.625rem;
    font-family: var(--font-family-display);
    font-size: 2.75rem;
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    line-height: 1;
  }

  .how-to-buy__step-title {
    margin-bottom: 0.625rem;
    font-family: "Archivo Variable", var(--font-family-body);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .how-to-buy__description {
    line-height: 1.5;
  }

  @media (min-width: 901px) {
    .how-to-buy__inner {
      grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr);
    }
  }

  @media (max-width: 720px) {
    .how-to-buy {
      padding-block: 3.5rem;
    }

    .how-to-buy__list {
      grid-template-columns: 1fr;
    }
  }
</style>
