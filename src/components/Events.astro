---
import { events } from "../data/events";

const orderedEvents = [...events].sort((a, b) => Number(b.isActive) - Number(a.isActive));

const shortDateFormatter = new Intl.DateTimeFormat("es-VE", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatShortDate = (isoDate: string) =>
  shortDateFormatter
    .format(new Date(`${isoDate}T00:00:00Z`))
    .replaceAll(".", "")
    .replace("sept", "sep");
---

<section class="events" id="tu-evento" aria-labelledby="events-title">
  <div class="events__inner">
    <header class="events__heading">
      <h2 id="events-title">Eventos</h2>
      <p>Entra a la galería de tu evento y elige tus fotos.</p>
    </header>

    <div class="events__grid">
      {
        orderedEvents.map((event) => {
          const eventId = `event-${event.url.split("/").filter(Boolean).at(-1)}`;

          return (
            <article
              class:list={[
                "events__card",
                event.isActive ? "events__card--active" : "events__card--past",
              ]}
              aria-labelledby={eventId}
            >
              {event.isActive ? (
                <p class="events__status">
                  <span>Black Sheep Sport</span>
                  <span class="events__status-label">
                    <span class="events__status-dot" aria-hidden="true" />
                    ÚLTIMO EVENTO
                  </span>
                </p>
              ) : (
                <p class="events__status events__status--center">Evento anterior</p>
              )}

              <div class="events__content">
                <h3 class="events__name" id={eventId}>{event.name}</h3>
                <p class="events__metadata">
                  <time datetime={event.isoDate}>{formatShortDate(event.isoDate)}</time>
                  <span>{event.location}</span>
                </p>
              </div>

              <a class="events__cta" href={event.url}>
                Ver galería
                {event.isActive && <span aria-hidden="true">→</span>}
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .events {
    padding-block: 5rem;
    background: var(--color-surface);
    border-block: 1px solid #dcdedb;
  }

  .events__inner {
    width: 100%;
    max-width: var(--container-max-width);
    padding-inline: var(--container-padding);
    margin-inline: auto;
  }

  .events__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .events__heading h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .events__heading p {
    margin: 0;
    color: var(--home-muted, var(--color-gray-500));
    line-height: 1.5;
  }

  .events__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(17.5rem, 1fr);
    gap: var(--space-5);
  }

  .events__card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 30rem;
    overflow: hidden;
    flex-direction: column;
    background: var(--color-surface);
    border: 2px solid var(--home-ink, var(--color-ink));
    border-radius: 0.75rem;
    transition: transform 180ms ease;
  }

  .events__card--active {
    background: #cdff3a;
  }

  .events__card::before,
  .events__card::after,
  .events__content::before,
  .events__content::after {
    position: absolute;
    z-index: 1;
    width: 0.875rem;
    height: 0.875rem;
    background: var(--color-surface);
    border: 2px solid var(--home-ink, var(--color-ink));
    border-radius: 50%;
    content: "";
  }

  .events__card::before {
    top: 0.875rem;
    left: 0.875rem;
  }

  .events__card::after {
    top: 0.875rem;
    right: 0.875rem;
  }

  .events__content::before {
    bottom: 0.875rem;
    left: 0.875rem;
  }

  .events__content::after {
    right: 0.875rem;
    bottom: 0.875rem;
  }

  .events__status {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 1rem 2.75rem;
    margin: 0;
    border-bottom: 2px dashed var(--home-ink, var(--color-ink));
    font-size: 0.75rem;
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .events__status--center {
    justify-content: center;
    color: var(--home-muted, var(--color-gray-500));
  }

  .events__status-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .events__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    background: var(--home-ink, var(--color-ink));
    border-radius: 50%;
  }

  .events__content {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.125rem;
    padding: 2.5rem 2.75rem 2rem;
    text-align: center;
  }

  .events__name {
    max-width: 7ch;
    margin: 0;
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: clamp(4.75rem, 9vw, 8rem);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.82;
    overflow-wrap: break-word;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .events__card--past .events__name {
    max-width: 9ch;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 0.9;
  }

  .events__metadata {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .events__metadata time,
  .events__metadata span {
    padding: 0.3125rem 0.625rem;
    border: 2px solid var(--home-ink, var(--color-ink));
  }

  .events__metadata time {
    background: var(--home-ink, var(--color-ink));
    color: #cdff3a;
  }

  .events__card--past .events__metadata time {
    color: var(--color-surface);
  }

  .events__cta {
    display: inline-flex;
    min-height: 3.375rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 1rem 1.5rem;
    margin: 0 2.25rem 2.25rem;
    background: var(--home-ink, var(--color-ink));
    border: 2px solid var(--home-ink, var(--color-ink));
    color: #cdff3a;
    font-size: 0.875rem;
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .events__card--past .events__cta {
    background: transparent;
    color: var(--home-ink, var(--color-ink));
  }

  .events__cta:active {
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .events__card--active:hover {
      transform: translateY(-0.25rem) rotate(-0.35deg);
    }

    .events__card--past:hover {
      transform: translateY(-0.25rem) rotate(0.35deg);
    }

    .events__card--active .events__cta:hover {
      background: var(--color-surface);
      color: var(--home-ink, var(--color-ink));
    }

    .events__card--past .events__cta:hover {
      background: var(--home-ink, var(--color-ink));
      color: var(--color-surface);
    }
  }

  @media (max-width: 56.25rem) {
    .events__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .events__card--past {
      min-height: 23.75rem;
    }

    .events__name {
      font-size: clamp(3.5rem, 20vw, 6.5rem);
    }
  }

  @media (max-width: 45rem) {
    .events {
      padding-block: 3.5rem;
    }

    .events__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .events__content {
      padding-inline: 1.75rem;
    }

    .events__cta {
      margin: 0 1.5rem 1.75rem;
    }
  }

  @media (max-width: 30rem) {
    .events__status {
      align-items: center;
      flex-direction: column;
      padding-inline: 2.375rem;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events__card,
    .events__cta {
      transition: none;
      transform: none;
    }
  }
</style>
