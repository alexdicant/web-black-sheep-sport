---
import { Image } from "astro:assets";
import muestra1 from "../assets/photos/DSC00134.webp";
import muestra2 from "../assets/photos/DSC09177.webp";
import muestra3 from "../assets/photos/DSC07499.webp";
import muestra4 from "../assets/photos/DSC08270.webp";
import muestra5 from "../assets/photos/DSC06183-Mejorado-NR.webp";
import muestra6 from "../assets/photos/DSC08317.webp";
import muestra7 from "../assets/photos/DSC08381-2.webp";
import muestra8 from "../assets/photos/DSC09992.webp";

const photos = [
  { src: muestra7, alt: "Atleta de pie dentro del gimnasio durante un evento deportivo" },
  { src: muestra2, alt: "Atleta dando una patada alta de kickboxing a un saco de boxeo" },
  { src: muestra5, alt: "Atleta visto de espaldas haciendo dominadas en una barra" },
  { src: muestra3, alt: "Atleta sonriendo con una raqueta después de una actividad deportiva" },
  { src: muestra4, alt: "Atleta con un brazo levantado durante una competencia de entrenamiento funcional" },
  { src: muestra8, alt: "Atleta recuperando el aliento frente a una barra en el gimnasio" },
  { src: muestra1, alt: "Atleta lanzando un golpe con guantes de boxeo" },
  { src: muestra6, alt: "Atleta preparándose durante una competencia de entrenamiento funcional" },
];
---

<section class="gallery" id="muestra" aria-labelledby="gallery-title">
  <div class="gallery__inner">
    <header class="gallery__heading">
      <h2 class="gallery__title" id="gallery-title">Muestra</h2>
      <p>Entregamos originales, en alta resolución y sin marca de agua.</p>
    </header>

    <div class="gallery__grid">
      {
        photos.map((photo) => (
          <Image
            class="gallery__image"
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            widths={[304, 448, 600, 800]}
            sizes="(max-width: 480px) calc(100vw - 32px), (max-width: 900px) calc(50vw - 20px), (max-width: 1288px) calc(25vw - 24px), 304px"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--section-space);
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .gallery__inner {
    width: 100%;
    max-width: var(--content-max);
    padding-inline: var(--content-gutter);
    margin-inline: auto;
  }

  .gallery__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .gallery__title {
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: var(--text-section-title);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .gallery__heading p {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .gallery__grid {
    columns: 4;
    column-gap: 0.5rem;
  }

  .gallery__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    break-inside: avoid;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 56.25rem) {
    .gallery__grid {
      columns: 2;
    }
  }

  @media (max-width: 45rem) {

    .gallery__heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

</style>
