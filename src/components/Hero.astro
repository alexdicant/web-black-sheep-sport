---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/DSC06482-Mejorado-NR.webp";
import { activeEvent } from "../data/events";

if (!activeEvent) {
  throw new Error("El Home necesita un evento activo para el label del hero.");
}
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__kicker">Fotografía deportiva · Mérida</p>
      <h1 class="hero__headline" id="hero-title">Así se ve<br />dar todo</h1>
      <p class="hero__lead">Tus fotos, del día que competiste. Listas para presumir.</p>
    </div>

    <figure class="hero__media">
      <Image
        class="hero__image"
        src={heroPhoto}
        alt="Atleta haciendo remo con barra en un gimnasio al aire libre, con el rostro pintado y expresión de esfuerzo intenso"
        loading="eager"
        fetchpriority="high"
        widths={[375, 675, 900, 1200]}
        sizes="(min-width: 1288px) 600px, (min-width: 721px) calc((100vw - 88px) / 2), calc(100vw - 32px)"
      />
      <figcaption class="hero__label">
        <a href={activeEvent.url} aria-label={`Ver último evento: ${activeEvent.name}`}>
          <span>ÚLTIMO EVENTO</span>
          <strong>{activeEvent.name}</strong>
        </a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: 40px 64px;
    background: var(--home-paper);
  }

  .hero__inner {
    display: flex;
    width: calc(100% - (2 * var(--home-gutter)));
    max-width: var(--home-container);
    align-items: center;
    gap: 40px;
    margin-inline: auto;
  }

  .hero__content,
  .hero__media {
    flex: 1 1 0;
    min-width: 0;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero__kicker {
    margin: 0;
    color: var(--home-muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__headline {
    margin: 0;
    font-family: "Archivo Variable", sans-serif;
    font-size: clamp(2.875rem, 6.6vw, 6rem);
    font-stretch: 125%;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .hero__lead {
    max-width: 34ch;
    margin: 0;
    color: var(--home-ink-soft);
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .hero__media {
    position: relative;
    height: clamp(340px, 40vw, 520px);
    margin: 0;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 34%;
  }

  .hero__label {
    position: absolute;
    bottom: 0;
    left: 0;
    margin: 0;
  }

  .hero__label a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    background: var(--color-accent);
    color: var(--home-ink);
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .hero__label span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero__label strong {
    font-size: 1.25rem;
    font-stretch: 125%;
    font-weight: 900;
  }

  .hero__label a:active {
    background: var(--home-ink);
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__label a:hover {
      background: var(--home-ink);
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__label a,
    .hero__label a:hover,
    .hero__label a:active {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 32px 48px;
    }

    .hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .hero__media {
      flex-basis: auto;
      width: 100%;
      height: min(120vw, 520px);
    }
  }
</style>
