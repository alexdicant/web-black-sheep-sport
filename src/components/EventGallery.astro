---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface EventPhoto {
  src: ImageMetadata;
  code: string;
}

interface Props {
  eventName: string;
  venue: string;
  date: string;
  isoDate: string;
  photos: EventPhoto[];
  storageKey: string;
}

const {
  eventName,
  venue,
  date,
  isoDate,
  photos,
  storageKey,
} = Astro.props;

const hasPhotos = photos.length > 0;
---

<section
  class="event-gallery"
  aria-labelledby="event-gallery-title"
  data-event-gallery={hasPhotos ? "" : undefined}
  data-event-name={hasPhotos ? eventName : undefined}
  data-storage-key={hasPhotos ? storageKey : undefined}
  data-has-selection={hasPhotos ? "false" : undefined}
>
  <header class="event-gallery__header">
    <h1 class="event-gallery__title" id="event-gallery-title">{eventName}</h1>
    <p class="event-gallery__meta">
      {venue} <span aria-hidden="true">·</span> <time datetime={isoDate}>{date}</time>
    </p>
    {
      hasPhotos && (
        <>
          <p class="event-gallery__instruction">Selecciona las fotos que quieras comprar.</p>
          <p class="event-gallery__hint">Puedes tocar una foto para añadirla o quitarla de tu selección.</p>
        </>
      )
    }
  </header>

  {
    hasPhotos ? (
      <>
        <svg class="event-gallery__symbols" aria-hidden="true">
          <symbol id="event-gallery-expand-icon" viewBox="0 0 24 24">
            <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            <path d="m14.5 14.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </symbol>
        </svg>
        <p class="event-gallery__status" aria-live="polite" aria-atomic="true" data-selection-status></p>
        <a class="selection-jump" href="#event-selection-bar" data-selection-jump hidden>
          Ir a mi selección
        </a>
        <div class="selection-bar" id="event-selection-bar" data-selection-bar hidden>
          <div class="selection-bar__inner">
            <div class="selection-bar__summary">
              <p class="selection-bar__count" data-selection-count>0 fotos seleccionadas</p>
              <p class="selection-bar__price" data-selection-price></p>
            </div>
            <button class="selection-bar__clear" type="button" data-clear-selection>Limpiar selección</button>
            <button class="selection-bar__buy" type="button" data-buy-selection>Comprar seleccionadas</button>
          </div>
        </div>
        <ul class="event-gallery__grid" aria-label={`Fotografías de ${eventName}`}>
          {photos.map((photo) => (
            <li class="event-gallery__item">
              <button
                class="photo-choice"
                type="button"
                aria-label={`Seleccionar foto ${photo.code}`}
                aria-pressed="false"
                data-photo-select
                data-photo-code={photo.code}
                data-selected="false"
              >
                <span class="photo-choice__media">
                  <Image
                    class="photo-choice__image"
                    src={photo.src}
                    alt={`Foto del evento ${eventName}, código ${photo.code}`}
                    data-photo-image
                    loading="lazy"
                    decoding="async"
                    widths={[200, 400]}
                    sizes="(min-width: 1200px) 15vw, (min-width: 900px) 25vw, (min-width: 640px) 33vw, 50vw"
                  />
                  <span class="photo-choice__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m5 12.5 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
                    </svg>
                  </span>
                </span>
                <span class="photo-choice__code">{photo.code}</span>
              </button>
              <button
                class="photo-expand"
                type="button"
                aria-label={`Ampliar foto ${photo.code}`}
                data-photo-expand
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <use href="#event-gallery-expand-icon"></use>
                </svg>
              </button>
            </li>
          ))}
        </ul>

        <dialog
          class="photo-lightbox"
          aria-labelledby="photo-lightbox-code"
          data-photo-lightbox
        >
          <header class="photo-lightbox__header">
            <h2 class="photo-lightbox__code" id="photo-lightbox-code" data-lightbox-code></h2>
            <button
              class="photo-lightbox__close"
              type="button"
              aria-label="Cerrar vista ampliada"
              data-lightbox-close
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
              </svg>
            </button>
          </header>

          <div class="photo-lightbox__stage">
            <img
              class="photo-lightbox__image"
              src={undefined}
              alt=""
              decoding="async"
              data-lightbox-image
            />
          </div>

          <div class="photo-lightbox__controls">
            <button
              class="photo-lightbox__nav"
              type="button"
              aria-label="Foto anterior"
              data-lightbox-previous
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </button>
            <button
              class="photo-lightbox__select"
              type="button"
              aria-pressed="false"
              data-lightbox-select
            >
              Seleccionar foto
            </button>
            <button
              class="photo-lightbox__nav"
              type="button"
              aria-label="Foto siguiente"
              data-lightbox-next
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </button>
          </div>
        </dialog>
      </>
    ) : (
      <section class="event-gallery__empty">
        <p class="event-gallery__empty-label">PRÓXIMAMENTE</p>
        <h2 class="event-gallery__empty-title">Las fotos estarán disponibles pronto</h2>
        <p class="event-gallery__empty-text">
          Estamos preparando la galería de este evento. Cuando las fotos estén listas, aparecerán aquí.
        </p>
      </section>
    )
  }
</section>

<script src="../scripts/eventGallery.client.ts"></script>

<style>
  .event-gallery {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem) var(--container-padding) var(--space-section-block);
  }

  .event-gallery[data-has-selection="true"] {
    padding-bottom: calc(var(--space-section-block) + 7.5rem + env(safe-area-inset-bottom, 0px));
  }

  .event-gallery__header {
    max-width: var(--measure-prose);
    margin-bottom: var(--space-6);
  }

  .event-gallery__title {
    font-size: var(--font-size-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .event-gallery__meta {
    margin-top: var(--space-2);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__instruction {
    margin-top: var(--space-5);
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .event-gallery__hint {
    margin-top: var(--space-1);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__empty {
    max-width: var(--measure-prose);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
    border-top: 1px solid var(--color-gray-300);
  }

  .event-gallery__empty-label {
    color: var(--color-gray-500);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .event-gallery__empty-title {
    margin-top: var(--space-2);
    font-family: var(--font-family-display);
    font-size: clamp(var(--font-size-xl), 5vw, var(--font-size-2xl));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .event-gallery__empty-text {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--color-gray-500);
  }

  .event-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-1);
  }

  .event-gallery__symbols {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .event-gallery__item {
    position: relative;
    min-width: 0;
  }

  .photo-choice {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: border-color 140ms ease, background-color 140ms ease, transform 100ms ease;
  }

  .photo-choice__media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .photo-choice__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .photo-choice__check {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--color-gray-400);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 1px 3px rgba(13, 15, 12, 0.2);
    color: var(--color-accent);
    transform: scale(0.9);
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__check svg {
    width: 18px;
    height: 18px;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 120ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__code {
    display: block;
    min-height: 38px;
    padding: var(--space-2) var(--space-1);
    overflow-wrap: anywhere;
    color: var(--color-gray-500);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .photo-choice[data-selected="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .photo-choice[data-selected="true"] .photo-choice__check {
    border-color: var(--color-accent);
    background: var(--color-ink);
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__check svg {
    opacity: 1;
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__code {
    color: var(--color-accent-on);
  }

  .photo-choice:active {
    transform: scale(0.985);
  }

  .photo-choice:focus-visible,
  .photo-expand:focus-visible,
  .photo-lightbox__close:focus-visible,
  .photo-lightbox__nav:focus-visible,
  .photo-lightbox__select:focus-visible,
  .selection-bar__clear:focus-visible,
  .selection-bar__buy:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
    box-shadow: 0 0 0 1px var(--color-ink);
  }

  .photo-expand {
    position: absolute;
    z-index: 2;
    top: calc(var(--space-2) + 2px);
    left: calc(var(--space-2) + 2px);
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(242, 244, 243, 0.72);
    border-radius: var(--radius-sm);
    background: rgba(13, 15, 12, 0.76);
    color: var(--color-ink-inverse);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .photo-expand svg,
  .photo-lightbox__close svg,
  .photo-lightbox__nav svg {
    width: 20px;
    height: 20px;
  }

  .photo-expand:active,
  .photo-lightbox__close:active,
  .photo-lightbox__nav:active,
  .photo-lightbox__select:active {
    transform: translateY(1px);
  }

  :global(html:has(.photo-lightbox[open])) {
    overflow: hidden;
  }

  .photo-lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding:
      max(var(--space-3), env(safe-area-inset-top, 0px))
      max(var(--space-3), env(safe-area-inset-right, 0px))
      max(var(--space-3), env(safe-area-inset-bottom, 0px))
      max(var(--space-3), env(safe-area-inset-left, 0px));
    margin: 0;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-inverse);
  }

  .photo-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
  }

  .photo-lightbox::backdrop {
    background: rgba(5, 7, 6, 0.92);
  }

  .photo-lightbox__header {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .photo-lightbox__code {
    overflow: hidden;
    color: var(--color-ink-inverse);
    font-size: var(--font-size-sm);
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .photo-lightbox__close,
  .photo-lightbox__nav {
    display: grid;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--color-gray-500);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-inverse);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-lightbox__stage {
    display: flex;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #080a08;
  }

  .photo-lightbox__image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .photo-lightbox__controls {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    gap: var(--space-2);
    align-items: center;
  }

  .photo-lightbox__select {
    min-width: 0;
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-gray-500);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-inverse);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-lightbox__select[data-selected="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-on);
  }

  .photo-lightbox__nav:disabled {
    opacity: 0.32;
    cursor: default;
  }

  .event-gallery__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .selection-bar[hidden] {
    display: none;
  }

  .selection-jump {
    position: fixed;
    z-index: var(--layer-skip);
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-ink);
    color: var(--color-accent);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transform: translateY(calc(-100% - var(--space-3)));
  }

  .selection-jump:focus-visible {
    transform: translateY(0);
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .selection-bar {
    position: fixed;
    z-index: var(--layer-action);
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid var(--color-accent);
    background: var(--color-ink);
    color: var(--color-ink-inverse);
  }

  .selection-bar__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-3) var(--container-padding) max(var(--space-3), env(safe-area-inset-bottom, 0px));
  }

  .selection-bar__count {
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .selection-bar__summary {
    min-width: 0;
  }

  .selection-bar__price {
    margin-top: var(--space-1);
    color: var(--color-accent);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    line-height: 1.2;
  }

  .selection-bar__clear,
  .selection-bar__buy {
    min-height: 44px;
    border-radius: var(--radius-sm);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .selection-bar__clear {
    padding: var(--space-2) var(--space-1);
    border: 0;
    background: transparent;
    color: var(--color-gray-300);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .selection-bar__buy {
    grid-column: 1 / -1;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-on);
  }

  .selection-bar__clear:active,
  .selection-bar__buy:active {
    transform: translateY(1px);
  }

  :global(html[data-event-selection-active="true"] .back-to-top) {
    bottom: calc(7.5rem + max(var(--space-4), env(safe-area-inset-bottom, 0px)));
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-choice:hover:not([data-selected="true"]) {
      border-color: var(--color-gray-300);
      background: var(--color-gray-100);
    }

    .selection-bar__clear:hover {
      color: var(--color-ink-inverse);
    }

    .selection-bar__buy:hover {
      background: var(--color-surface);
      border-color: var(--color-surface);
    }

    .photo-expand:hover,
    .photo-lightbox__close:hover,
    .photo-lightbox__nav:hover:not(:disabled),
    .photo-lightbox__select:hover:not([data-selected="true"]) {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  @media (min-width: 640px) {
    .event-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4) var(--space-2);
    }

    .photo-lightbox {
      width: min(calc(100% - 3rem), 90rem);
      height: min(calc(100dvh - 3rem), 56rem);
      margin: auto;
      padding: var(--space-4);
      border: 1px solid var(--color-gray-500);
      border-radius: var(--radius-sm);
    }

    .photo-lightbox__controls {
      grid-template-columns: 52px minmax(12rem, 20rem) 52px;
      justify-content: center;
    }
  }

  @media (min-width: 900px) {
    .event-gallery[data-has-selection="true"] {
      padding-bottom: calc(var(--space-section-block) + 5rem + env(safe-area-inset-bottom, 0px));
    }

    .event-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .selection-bar__inner {
      grid-template-columns: minmax(11rem, 1fr) auto auto;
      gap: var(--space-4);
      padding-block: var(--space-3) max(var(--space-3), env(safe-area-inset-bottom, 0px));
    }

    .selection-bar__buy {
      grid-column: auto;
      width: auto;
      min-width: 15rem;
      padding-inline: var(--space-5);
    }

    :global(html[data-event-selection-active="true"] .back-to-top) {
      bottom: calc(5rem + max(var(--space-4), env(safe-area-inset-bottom, 0px)));
    }
  }

  @media (min-width: 1200px) {
    .event-gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-choice,
    .photo-choice__check,
    .photo-choice__check svg,
    .photo-choice:active,
    .photo-expand:active,
    .photo-lightbox__close:active,
    .photo-lightbox__nav:active,
    .photo-lightbox__select:active,
    .selection-bar__clear:active,
    .selection-bar__buy:active {
      transition: none;
      transform: none;
    }
  }
</style>
