---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface EventPhoto {
  src: ImageMetadata;
  code: string;
}

interface Props {
  eventName: string;
  venue: string;
  date: string;
  isoDate: string;
  photos: EventPhoto[];
  storageKey: string;
  whatsappNumber: string;
}

const {
  eventName,
  venue,
  date,
  isoDate,
  photos,
  storageKey,
  whatsappNumber,
} = Astro.props;

const hasPhotos = photos.length > 0;
---

<section
  class="event-gallery"
  aria-labelledby="event-gallery-title"
  data-event-gallery={hasPhotos ? "" : undefined}
  data-event-name={hasPhotos ? eventName : undefined}
  data-storage-key={hasPhotos ? storageKey : undefined}
  data-whatsapp-number={hasPhotos ? whatsappNumber : undefined}
  data-has-selection={hasPhotos ? "false" : undefined}
>
  <header class="event-gallery__header">
    <h1 class="event-gallery__title" id="event-gallery-title">{eventName}</h1>
    <p class="event-gallery__meta">
      {venue} <span aria-hidden="true">·</span> <time datetime={isoDate}>{date}</time>
    </p>
    {
      hasPhotos && (
        <>
          <p class="event-gallery__instruction">Selecciona las fotos que quieras comprar.</p>
          <p class="event-gallery__hint">Puedes tocar una foto para añadirla o quitarla de tu selección.</p>
        </>
      )
    }
  </header>

  {
    hasPhotos ? (
      <>
        <svg class="event-gallery__symbols" aria-hidden="true">
          <symbol id="event-gallery-expand-icon" viewBox="0 0 24 24">
            <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            <path d="m14.5 14.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </symbol>
        </svg>
        <ul class="event-gallery__grid" aria-label={`Fotografías de ${eventName}`}>
          {photos.map((photo) => (
            <li class="event-gallery__item">
              <button
                class="photo-choice"
                type="button"
                aria-label={`Seleccionar foto ${photo.code}`}
                aria-pressed="false"
                data-photo-select
                data-photo-code={photo.code}
                data-selected="false"
              >
                <span class="photo-choice__media">
                  <Image
                    class="photo-choice__image"
                    src={photo.src}
                    alt={`Foto del evento ${eventName}, código ${photo.code}`}
                    data-photo-image
                    loading="lazy"
                    decoding="async"
                    widths={[200, 400]}
                    sizes="(min-width: 1200px) 15vw, (min-width: 900px) 25vw, (min-width: 640px) 33vw, 50vw"
                  />
                  <span class="photo-choice__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m5 12.5 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
                    </svg>
                  </span>
                </span>
                <span class="photo-choice__code">{photo.code}</span>
              </button>
              <button
                class="photo-expand"
                type="button"
                aria-label={`Ampliar foto ${photo.code}`}
                data-photo-expand
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <use href="#event-gallery-expand-icon"></use>
                </svg>
              </button>
            </li>
          ))}
        </ul>

        <p class="event-gallery__status" aria-live="polite" aria-atomic="true" data-selection-status></p>

        <div class="selection-bar" data-selection-bar hidden>
          <div class="selection-bar__inner">
            <div class="selection-bar__summary">
              <p class="selection-bar__count" aria-live="polite" aria-atomic="true" data-selection-count>
                0 fotos seleccionadas
              </p>
              <p class="selection-bar__price" data-selection-price></p>
            </div>
            <button class="selection-bar__clear" type="button" data-clear-selection>
              Limpiar selección
            </button>
            <button class="selection-bar__buy" type="button" data-buy-selection>
              Comprar seleccionadas
            </button>
          </div>
        </div>

        <dialog
          class="photo-lightbox"
          aria-label="Vista ampliada de la galería"
          data-photo-lightbox
        >
          <header class="photo-lightbox__header">
            <h2 class="photo-lightbox__code" data-lightbox-code></h2>
            <button
              class="photo-lightbox__close"
              type="button"
              aria-label="Cerrar vista ampliada"
              data-lightbox-close
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
              </svg>
            </button>
          </header>

          <div class="photo-lightbox__stage">
            <img
              class="photo-lightbox__image"
              src={undefined}
              alt=""
              decoding="async"
              data-lightbox-image
            />
          </div>

          <div class="photo-lightbox__controls">
            <button
              class="photo-lightbox__nav"
              type="button"
              aria-label="Foto anterior"
              data-lightbox-previous
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </button>
            <button
              class="photo-lightbox__select"
              type="button"
              aria-pressed="false"
              data-lightbox-select
            >
              Seleccionar foto
            </button>
            <button
              class="photo-lightbox__nav"
              type="button"
              aria-label="Foto siguiente"
              data-lightbox-next
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </button>
          </div>
        </dialog>
      </>
    ) : (
      <section class="event-gallery__empty">
        <p class="event-gallery__empty-label">PRÓXIMAMENTE</p>
        <h2 class="event-gallery__empty-title">Las fotos estarán disponibles pronto</h2>
        <p class="event-gallery__empty-text">
          Estamos preparando la galería de este evento. Cuando las fotos estén listas, aparecerán aquí.
        </p>
      </section>
    )
  }
</section>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-event-gallery]");

  if (gallery) {
    const buttons = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-photo-select]"),
    );
    const expandButtons = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-photo-expand]"),
    );
    const selectionBar = gallery.querySelector<HTMLElement>("[data-selection-bar]");
    const selectionCount = gallery.querySelector<HTMLElement>("[data-selection-count]");
    const selectionPrice = gallery.querySelector<HTMLElement>("[data-selection-price]");
    const selectionStatus = gallery.querySelector<HTMLElement>("[data-selection-status]");
    const clearButton = gallery.querySelector<HTMLButtonElement>("[data-clear-selection]");
    const buyButton = gallery.querySelector<HTMLButtonElement>("[data-buy-selection]");
    const lightbox = gallery.querySelector<HTMLDialogElement>("[data-photo-lightbox]");
    const lightboxImage = gallery.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const lightboxCode = gallery.querySelector<HTMLElement>("[data-lightbox-code]");
    const lightboxClose = gallery.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const lightboxPrevious = gallery.querySelector<HTMLButtonElement>("[data-lightbox-previous]");
    const lightboxNext = gallery.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const lightboxSelect = gallery.querySelector<HTMLButtonElement>("[data-lightbox-select]");
    const eventName = gallery.dataset.eventName ?? "este evento";
    const storageKey = gallery.dataset.storageKey ?? "black-sheep-selection";
    const whatsappNumber = gallery.dataset.whatsappNumber ?? "";
    const SINGLE_PHOTO_PRICE = "US$4";
    const TWO_PHOTO_PRICE = "US$7";
    const ALL_PHOTOS_PRICE = "US$12";
    const PACKAGE_INFO_THRESHOLD = 3;
    const availableCodes = new Set(
      buttons.map((button) => button.dataset.photoCode).filter((code): code is string => Boolean(code)),
    );
    const selectedCodes = new Set<string>();
    let currentPhotoIndex = -1;
    let lightboxTrigger: HTMLButtonElement | null = null;

    const getOrderedCodes = () =>
      buttons
        .map((button) => button.dataset.photoCode)
        .filter((code): code is string => Boolean(code) && selectedCodes.has(code));

    const getPricingInfoLabel = (count: number) => {
      if (count === 1) return SINGLE_PHOTO_PRICE;
      if (count === 2) return TWO_PHOTO_PRICE;
      if (count >= PACKAGE_INFO_THRESHOLD) {
        return `Paquete disponible: Todas tus fotos · ${ALL_PHOTOS_PRICE} por atleta`;
      }
      return "";
    };

    const saveSelection = () => {
      try {
        const codes = getOrderedCodes();

        if (codes.length === 0) {
          localStorage.removeItem(storageKey);
          return;
        }

        localStorage.setItem(storageKey, JSON.stringify(codes));
      } catch {
        // La galería sigue funcionando si el navegador bloquea localStorage.
      }
    };

    const updateLightboxSelection = () => {
      if (!lightboxSelect || currentPhotoIndex < 0) return;

      const code = buttons[currentPhotoIndex]?.dataset.photoCode ?? "";
      const isSelected = selectedCodes.has(code);
      lightboxSelect.dataset.selected = String(isSelected);
      lightboxSelect.setAttribute("aria-pressed", String(isSelected));
      lightboxSelect.setAttribute(
        "aria-label",
        isSelected
          ? `Quitar foto ${code} de la selección`
          : `Seleccionar foto ${code}`,
      );
      lightboxSelect.textContent = isSelected ? "Seleccionada" : "Seleccionar foto";
    };

    const updateInterface = (announcement = "") => {
      const count = selectedCodes.size;
      const hasSelection = count > 0;

      buttons.forEach((button) => {
        const code = button.dataset.photoCode ?? "";
        const isSelected = selectedCodes.has(code);
        button.dataset.selected = String(isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
        button.setAttribute(
          "aria-label",
          isSelected
            ? `Quitar foto ${code} de la selección`
            : `Seleccionar foto ${code}`,
        );
      });

      if (selectionCount) {
        selectionCount.textContent =
          count === 1 ? "1 foto seleccionada" : `${count} fotos seleccionadas`;
      }

      if (selectionPrice) selectionPrice.textContent = getPricingInfoLabel(count);
      if (buyButton) {
        buyButton.textContent =
          count === 1 ? "Comprar seleccionada" : "Comprar seleccionadas";
      }

      if (selectionBar) selectionBar.hidden = !hasSelection;
      gallery.dataset.hasSelection = String(hasSelection);

      if (hasSelection) {
        document.documentElement.dataset.eventSelectionActive = "true";
      } else {
        delete document.documentElement.dataset.eventSelectionActive;
      }

      if (selectionStatus && announcement) selectionStatus.textContent = announcement;
      updateLightboxSelection();
    };

    const toggleSelection = (code: string) => {
      if (selectedCodes.has(code)) {
        selectedCodes.delete(code);
        updateInterface(`Foto ${code} eliminada de la selección.`);
      } else {
        selectedCodes.add(code);
        updateInterface(`Foto ${code} añadida a la selección.`);
      }

      saveSelection();
    };

    const showLightboxPhoto = (index: number) => {
      const selectButton = buttons[index];
      const image = selectButton?.querySelector<HTMLImageElement>("[data-photo-image]");
      const code = selectButton?.dataset.photoCode ?? "";
      if (!image || !lightboxImage || !lightboxCode) return;

      currentPhotoIndex = index;
      lightboxCode.textContent = code;
      lightboxImage.alt = image.alt;
      lightboxImage.src = image.getAttribute("src") ?? image.currentSrc;

      if (lightboxPrevious) lightboxPrevious.disabled = index === 0;
      if (lightboxNext) lightboxNext.disabled = index === buttons.length - 1;

      updateLightboxSelection();
    };

    const openLightbox = (index: number, trigger: HTMLButtonElement) => {
      if (!lightbox || !lightboxClose) return;

      lightboxTrigger = trigger;
      showLightboxPhoto(index);
      lightbox.showModal();
      lightboxClose.focus({ preventScroll: true });
    };

    const moveLightbox = (direction: -1 | 1) => {
      const nextIndex = currentPhotoIndex + direction;
      if (nextIndex < 0 || nextIndex >= buttons.length) return;
      showLightboxPhoto(nextIndex);
    };

    try {
      const storedSelection = JSON.parse(localStorage.getItem(storageKey) ?? "[]");

      if (Array.isArray(storedSelection)) {
        storedSelection.forEach((code) => {
          if (typeof code === "string" && availableCodes.has(code)) selectedCodes.add(code);
        });
      }
    } catch {
      // Un valor inválido no debe impedir que el usuario seleccione fotos.
    }

    updateInterface();

    gallery.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const expandButton = target.closest<HTMLButtonElement>("[data-photo-expand]");
      if (expandButton && gallery.contains(expandButton)) {
        event.stopPropagation();
        const index = expandButtons.indexOf(expandButton);
        if (index >= 0) openLightbox(index, expandButton);
        return;
      }

      const button = target.closest<HTMLButtonElement>("[data-photo-select]");
      if (!button || !gallery.contains(button)) return;

      const code = button.dataset.photoCode;
      if (!code) return;
      toggleSelection(code);
    });

    lightboxClose?.addEventListener("click", () => lightbox?.close());
    lightboxPrevious?.addEventListener("click", () => moveLightbox(-1));
    lightboxNext?.addEventListener("click", () => moveLightbox(1));
    lightboxSelect?.addEventListener("click", () => {
      const code = buttons[currentPhotoIndex]?.dataset.photoCode;
      if (code) toggleSelection(code);
    });

    lightbox?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveLightbox(-1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        moveLightbox(1);
      }
    });

    lightbox?.addEventListener("close", () => {
      lightboxImage?.removeAttribute("src");
      lightboxTrigger?.focus({ preventScroll: true });
    });

    clearButton?.addEventListener("click", () => {
      selectedCodes.clear();
      saveSelection();
      updateInterface("Selección borrada.");
    });

    buyButton?.addEventListener("click", () => {
      const codes = getOrderedCodes();
      if (codes.length === 0) return;

      const message =
        codes.length >= PACKAGE_INFO_THRESHOLD
          ? `Hola, vi mis fotos de ${eventName} y seleccioné estas fotos: ${codes.join(", ")}. Vi que tienen el paquete Todas tus fotos por ${ALL_PHOTOS_PRICE} por atleta. ¿Me ayudas con la compra?`
          : `Hola, vi mis fotos de ${eventName} y quiero comprar estas fotos: ${codes.join(", ")}. ¿Me ayudas con el proceso de pago?`;
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      const link = document.createElement("a");
      link.href = whatsappUrl;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.click();
    });
  }
</script>

<style>
  .event-gallery {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem) var(--container-padding) var(--space-section-block);
  }

  .event-gallery[data-has-selection="true"] {
    padding-bottom: calc(var(--space-section-block) + 7.5rem + env(safe-area-inset-bottom, 0px));
  }

  .event-gallery__header {
    max-width: var(--measure-prose);
    margin-bottom: var(--space-6);
  }

  .event-gallery__title {
    font-size: var(--font-size-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .event-gallery__meta {
    margin-top: var(--space-2);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__instruction {
    margin-top: var(--space-5);
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .event-gallery__hint {
    margin-top: var(--space-1);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__empty {
    max-width: var(--measure-prose);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
    border-top: 1px solid var(--color-gray-300);
  }

  .event-gallery__empty-label {
    color: var(--color-gray-500);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .event-gallery__empty-title {
    margin-top: var(--space-2);
    font-family: var(--font-family-display);
    font-size: clamp(var(--font-size-xl), 5vw, var(--font-size-2xl));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .event-gallery__empty-text {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--color-gray-500);
  }

  .event-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-1);
  }

  .event-gallery__symbols {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .event-gallery__item {
    position: relative;
    min-width: 0;
  }

  .photo-choice {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: border-color 140ms ease, background-color 140ms ease, transform 100ms ease;
  }

  .photo-choice__media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .photo-choice__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .photo-choice__check {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--color-gray-400);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 1px 3px rgba(13, 15, 12, 0.2);
    color: var(--color-accent);
    transform: scale(0.9);
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__check svg {
    width: 18px;
    height: 18px;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 120ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__code {
    display: block;
    min-height: 38px;
    padding: var(--space-2) var(--space-1);
    overflow-wrap: anywhere;
    color: var(--color-gray-500);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .photo-choice[data-selected="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .photo-choice[data-selected="true"] .photo-choice__check {
    border-color: var(--color-accent);
    background: var(--color-ink);
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__check svg {
    opacity: 1;
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__code {
    color: var(--color-accent-on);
  }

  .photo-choice:active {
    transform: scale(0.985);
  }

  .photo-choice:focus-visible,
  .photo-expand:focus-visible,
  .photo-lightbox__close:focus-visible,
  .photo-lightbox__nav:focus-visible,
  .photo-lightbox__select:focus-visible,
  .selection-bar__clear:focus-visible,
  .selection-bar__buy:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
    box-shadow: 0 0 0 1px var(--color-ink);
  }

  .photo-expand {
    position: absolute;
    z-index: 2;
    top: calc(var(--space-2) + 2px);
    left: calc(var(--space-2) + 2px);
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(242, 244, 243, 0.72);
    border-radius: var(--radius-sm);
    background: rgba(13, 15, 12, 0.76);
    color: var(--color-ink-inverse);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .photo-expand svg,
  .photo-lightbox__close svg,
  .photo-lightbox__nav svg {
    width: 20px;
    height: 20px;
  }

  .photo-expand:active,
  .photo-lightbox__close:active,
  .photo-lightbox__nav:active,
  .photo-lightbox__select:active {
    transform: translateY(1px);
  }

  :global(html:has(.photo-lightbox[open])) {
    overflow: hidden;
  }

  .photo-lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding:
      max(var(--space-3), env(safe-area-inset-top, 0px))
      max(var(--space-3), env(safe-area-inset-right, 0px))
      max(var(--space-3), env(safe-area-inset-bottom, 0px))
      max(var(--space-3), env(safe-area-inset-left, 0px));
    margin: 0;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-inverse);
  }

  .photo-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
  }

  .photo-lightbox::backdrop {
    background: rgba(5, 7, 6, 0.92);
  }

  .photo-lightbox__header {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .photo-lightbox__code {
    overflow: hidden;
    color: var(--color-ink-inverse);
    font-size: var(--font-size-sm);
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .photo-lightbox__close,
  .photo-lightbox__nav {
    display: grid;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--color-gray-500);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-inverse);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-lightbox__stage {
    display: flex;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
