---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface EventPhoto {
  src: ImageMetadata;
  code: string;
}

interface Props {
  eventName: string;
  venue: string;
  date: string;
  isoDate: string;
  photos: EventPhoto[];
  storageKey: string;
  whatsappNumber: string;
}

const {
  eventName,
  venue,
  date,
  isoDate,
  photos,
  storageKey,
  whatsappNumber,
} = Astro.props;
---

<section
  class="event-gallery"
  aria-labelledby="event-gallery-title"
  data-event-gallery
  data-event-name={eventName}
  data-storage-key={storageKey}
  data-whatsapp-number={whatsappNumber}
  data-has-selection="false"
>
  <header class="event-gallery__header">
    <h1 class="event-gallery__title" id="event-gallery-title">{eventName}</h1>
    <p class="event-gallery__meta">
      {venue} <span aria-hidden="true">·</span> <time datetime={isoDate}>{date}</time>
    </p>
    <p class="event-gallery__instruction">Selecciona las fotos que quieras comprar.</p>
    <p class="event-gallery__hint">Puedes tocar una foto para añadirla o quitarla de tu selección.</p>
  </header>

  <ul class="event-gallery__grid" aria-label={`Fotografías de ${eventName}`}>
    {
      photos.map((photo) => (
        <li class="event-gallery__item">
          <button
            class="photo-choice"
            type="button"
            aria-label={`Seleccionar foto ${photo.code}`}
            aria-pressed="false"
            data-photo-select
            data-photo-code={photo.code}
            data-selected="false"
          >
            <span class="photo-choice__media">
              <Image
                class="photo-choice__image"
                src={photo.src}
                alt={`Foto del evento ${eventName}, código ${photo.code}`}
                loading="lazy"
                decoding="async"
                widths={[200, 400]}
                sizes="(min-width: 1200px) 15vw, (min-width: 900px) 25vw, (min-width: 640px) 33vw, 50vw"
              />
              <span class="photo-choice__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m5 12.5 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
                </svg>
              </span>
            </span>
            <span class="photo-choice__code">{photo.code}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <p class="event-gallery__status" aria-live="polite" aria-atomic="true" data-selection-status></p>

  <div class="selection-bar" data-selection-bar hidden>
    <div class="selection-bar__inner">
      <p class="selection-bar__count" aria-live="polite" aria-atomic="true" data-selection-count>
        0 fotos seleccionadas
      </p>
      <button class="selection-bar__clear" type="button" data-clear-selection>
        Limpiar selección
      </button>
      <button class="selection-bar__buy" type="button" data-buy-selection>
        Comprar seleccionadas
      </button>
    </div>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-event-gallery]");

  if (gallery) {
    const buttons = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-photo-select]"),
    );
    const selectionBar = gallery.querySelector<HTMLElement>("[data-selection-bar]");
    const selectionCount = gallery.querySelector<HTMLElement>("[data-selection-count]");
    const selectionStatus = gallery.querySelector<HTMLElement>("[data-selection-status]");
    const clearButton = gallery.querySelector<HTMLButtonElement>("[data-clear-selection]");
    const buyButton = gallery.querySelector<HTMLButtonElement>("[data-buy-selection]");
    const eventName = gallery.dataset.eventName ?? "este evento";
    const storageKey = gallery.dataset.storageKey ?? "black-sheep-selection";
    const whatsappNumber = gallery.dataset.whatsappNumber ?? "";
    const availableCodes = new Set(
      buttons.map((button) => button.dataset.photoCode).filter((code): code is string => Boolean(code)),
    );
    const selectedCodes = new Set<string>();

    const getOrderedCodes = () =>
      buttons
        .map((button) => button.dataset.photoCode)
        .filter((code): code is string => Boolean(code) && selectedCodes.has(code));

    const saveSelection = () => {
      try {
        const codes = getOrderedCodes();

        if (codes.length === 0) {
          localStorage.removeItem(storageKey);
          return;
        }

        localStorage.setItem(storageKey, JSON.stringify(codes));
      } catch {
        // La galería sigue funcionando si el navegador bloquea localStorage.
      }
    };

    const updateInterface = (announcement = "") => {
      const count = selectedCodes.size;
      const hasSelection = count > 0;

      buttons.forEach((button) => {
        const code = button.dataset.photoCode ?? "";
        const isSelected = selectedCodes.has(code);
        button.dataset.selected = String(isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
        button.setAttribute(
          "aria-label",
          isSelected
            ? `Quitar foto ${code} de la selección`
            : `Seleccionar foto ${code}`,
        );
      });

      if (selectionCount) {
        selectionCount.textContent =
          count === 1 ? "1 foto seleccionada" : `${count} fotos seleccionadas`;
      }

      if (selectionBar) selectionBar.hidden = !hasSelection;
      gallery.dataset.hasSelection = String(hasSelection);

      if (hasSelection) {
        document.documentElement.dataset.eventSelectionActive = "true";
      } else {
        delete document.documentElement.dataset.eventSelectionActive;
      }

      if (selectionStatus && announcement) selectionStatus.textContent = announcement;
    };

    try {
      const storedSelection = JSON.parse(localStorage.getItem(storageKey) ?? "[]");

      if (Array.isArray(storedSelection)) {
        storedSelection.forEach((code) => {
          if (typeof code === "string" && availableCodes.has(code)) selectedCodes.add(code);
        });
      }
    } catch {
      // Un valor inválido no debe impedir que el usuario seleccione fotos.
    }

    updateInterface();

    gallery.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("[data-photo-select]");
      if (!button || !gallery.contains(button)) return;

      const code = button.dataset.photoCode;
      if (!code) return;

      if (selectedCodes.has(code)) {
        selectedCodes.delete(code);
        updateInterface(`Foto ${code} eliminada de la selección.`);
      } else {
        selectedCodes.add(code);
        updateInterface(`Foto ${code} añadida a la selección.`);
      }

      saveSelection();
    });

    clearButton?.addEventListener("click", () => {
      selectedCodes.clear();
      saveSelection();
      updateInterface("Selección borrada.");
    });

    buyButton?.addEventListener("click", () => {
      const codes = getOrderedCodes();
      if (codes.length === 0) return;

      const message = `Hola, vi mis fotos de ${eventName} y quiero comprar estas fotos: ${codes.join(", ")}. ¿Me ayudas con el proceso de pago?`;
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      const link = document.createElement("a");
      link.href = whatsappUrl;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.click();
    });
  }
</script>

<style>
  .event-gallery {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem) var(--container-padding) var(--space-section-block);
  }

  .event-gallery[data-has-selection="true"] {
    padding-bottom: calc(var(--space-section-block) + 7.5rem + env(safe-area-inset-bottom, 0px));
  }

  .event-gallery__header {
    max-width: var(--measure-prose);
    margin-bottom: var(--space-6);
  }

  .event-gallery__title {
    font-size: var(--font-size-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .event-gallery__meta {
    margin-top: var(--space-2);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__instruction {
    margin-top: var(--space-5);
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .event-gallery__hint {
    margin-top: var(--space-1);
    color: var(--color-gray-500);
    font-size: var(--font-size-sm);
  }

  .event-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-1);
  }

  .event-gallery__item {
    min-width: 0;
  }

  .photo-choice {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: border-color 140ms ease, background-color 140ms ease, transform 100ms ease;
  }

  .photo-choice__media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .photo-choice__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .photo-choice__check {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--color-gray-400);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 1px 3px rgba(13, 15, 12, 0.2);
    color: var(--color-accent);
    transform: scale(0.9);
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__check svg {
    width: 18px;
    height: 18px;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 120ms ease,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .photo-choice__code {
    display: block;
    min-height: 38px;
    padding: var(--space-2) var(--space-1);
    overflow-wrap: anywhere;
    color: var(--color-gray-500);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .photo-choice[data-selected="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .photo-choice[data-selected="true"] .photo-choice__check {
    border-color: var(--color-accent);
    background: var(--color-ink);
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__check svg {
    opacity: 1;
    transform: scale(1);
  }

  .photo-choice[data-selected="true"] .photo-choice__code {
    color: var(--color-accent-on);
  }

  .photo-choice:active {
    transform: scale(0.985);
  }

  .event-gallery__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .selection-bar[hidden] {
    display: none;
  }

  .selection-bar {
    position: fixed;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid var(--color-accent);
    background: var(--color-ink);
    color: var(--color-ink-inverse);
  }

  .selection-bar__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-3) var(--container-padding) max(var(--space-3), env(safe-area-inset-bottom, 0px));
  }

  .selection-bar__count {
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .selection-bar__clear,
  .selection-bar__buy {
    min-height: 44px;
    border-radius: var(--radius-sm);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xs);
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .selection-bar__clear {
    padding: var(--space-2) var(--space-1);
    border: 0;
    background: transparent;
    color: var(--color-gray-300);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .selection-bar__buy {
    grid-column: 1 / -1;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-on);
  }

  .selection-bar__clear:active,
  .selection-bar__buy:active {
    transform: translateY(1px);
  }

  :global(html[data-event-selection-active="true"] .back-to-top) {
    bottom: calc(7.5rem + max(var(--space-4), env(safe-area-inset-bottom, 0px)));
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-choice:hover:not([data-selected="true"]) {
      border-color: var(--color-gray-300);
      background: var(--color-gray-100);
    }

    .selection-bar__clear:hover {
      color: var(--color-ink-inverse);
    }

    .selection-bar__buy:hover {
      background: var(--color-surface);
      border-color: var(--color-surface);
    }
  }

  @media (min-width: 640px) {
    .event-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4) var(--space-2);
    }
  }

  @media (min-width: 900px) {
    .event-gallery[data-has-selection="true"] {
      padding-bottom: calc(var(--space-section-block) + 5rem + env(safe-area-inset-bottom, 0px));
    }

    .event-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .selection-bar__inner {
      grid-template-columns: minmax(11rem, 1fr) auto auto;
      gap: var(--space-4);
      padding-block: var(--space-3) max(var(--space-3), env(safe-area-inset-bottom, 0px));
    }

    .selection-bar__buy {
      grid-column: auto;
      width: auto;
      min-width: 15rem;
      padding-inline: var(--space-5);
    }

    :global(html[data-event-selection-active="true"] .back-to-top) {
      bottom: calc(5rem + max(var(--space-4), env(safe-area-inset-bottom, 0px)));
    }
  }

  @media (min-width: 1200px) {
    .event-gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-choice,
    .photo-choice__check,
    .photo-choice:active,
    .selection-bar__clear:active,
    .selection-bar__buy:active {
      transform: none;
    }
  }
</style>
