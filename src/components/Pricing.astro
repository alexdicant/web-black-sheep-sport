---
import { pricingTiers } from "../data/pricing";
---

<section class="pricing" id="precios" aria-labelledby="pricing-title">
  <div class="pricing__inner">
    <header class="pricing__intro">
      <h2 class="pricing__title" id="pricing-title">Precios</h2>
      <p>Pagas por pago móvil o Binance.</p>
    </header>

    <div class="pricing__options">
      <div class="pricing__grid">
        {
          pricingTiers.map((tier) => (
            <article class:list={["pricing__tier", tier.isFeatured && "pricing__tier--featured"]}>
              {tier.isFeatured && <p class="pricing__badge">Más elegido</p>}
              <h3>{tier.label}</h3>
              <p class="pricing__tier-price">{tier.price}</p>
              {tier.unit && <p class="pricing__tier-unit">{tier.unit}</p>}
            </article>
          ))
        }
      </div>

      <div class="pricing__cta-wrap">
        <a class="pricing__cta" href="/#tu-evento">Buscar mis fotos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-space);
    background: var(--color-gray-100);
    color: var(--color-text);
  }

  .pricing__inner {
    display: grid;
    gap: 3rem;
    width: 100%;
    max-width: var(--content-max);
    padding-inline: var(--content-gutter);
    margin-inline: auto;
  }

  .pricing__title {
    margin: 0;
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: var(--text-section-title);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .pricing__intro p {
    max-width: 32ch;
    margin: 0.875rem 0 0;
    color: var(--color-gray-500);
    line-height: 1.5;
  }

  .pricing__options {
    min-width: 0;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.75rem;
  }

  .pricing__tier {
    position: relative;
    min-width: 0;
    padding: 1.75rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-gray-200);
  }

  .pricing__tier h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .pricing__tier-price {
    margin: 0;
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: clamp(2.125rem, 3.2vw, 2.75rem);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }

  .pricing__tier-unit {
    margin: 0.5rem 0 0;
    color: var(--color-gray-300);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pricing__tier--featured {
    background: var(--color-ink);
    color: var(--color-text-inverse);
    border-color: var(--color-ink);
  }

  .pricing__tier--featured h3 {
    font-weight: 700;
  }

  .pricing__badge {
    position: absolute;
    top: -0.8125rem;
    left: 1.5rem;
    margin: 0;
    padding: 0.3125rem 0.5625rem;
    background: var(--color-action);
    color: var(--color-ink);
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: 0.68rem;
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .pricing__tier--featured .pricing__tier-price {
    color: var(--color-accent);
  }

  .pricing__cta-wrap {
    display: flex;
    margin-top: 2rem;
  }

  .pricing__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-height);
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-action);
    color: var(--color-action-text);
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: 0.875rem;
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .pricing__cta:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .pricing__cta:hover {
      background: var(--color-ink);
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing__cta,
    .pricing__cta:hover,
    .pricing__cta:active {
      transition: none;
    }
  }

  @media (min-width: 56.25rem) {
    .pricing__inner {
      grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr);
    }
  }

  @media (max-width: 56.25rem) {
    .pricing__grid {
      padding-top: 0;
    }
  }

  @media (max-width: 45rem) {

    .pricing__grid {
      grid-template-columns: 1fr;
    }

    .pricing__tier--featured {
      margin-top: 0.625rem;
    }

    .pricing__cta {
      width: 100%;
    }
  }
</style>
