---
import { Image } from "astro:assets";
import logo from "../assets/log.png";

interface Props {
  variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;
const isHome = variant === "home";
---

<header class:list={["header", { "header--home": isHome }]} data-home-header={isHome ? "" : undefined}>
  <div class="header__inner">
    <a
      class="header__wordmark"
      href={isHome ? "#main-content" : "/"}
      aria-label="Black Sheep Sport, inicio"
    >
      <Image
        class="header__logo"
        src={logo}
        alt="Black Sheep Sport"
        width={264}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    {
      isHome ? (
        <>
          <button
            class="header__menu-button"
            type="button"
            aria-expanded="false"
            aria-controls="home-navigation"
          >
            <span class="sr-only">Abrir menú</span>
            <span aria-hidden="true" />
            <span aria-hidden="true" />
            <span aria-hidden="true" />
          </button>

          <nav id="home-navigation" class="header__nav" aria-label="Navegación principal">
            <a href="#tu-evento">Eventos</a>
            <a href="#precios">Precios</a>
            <a href="#preguntas">Preguntas</a>
            <a class="header__home-cta" href="#tu-evento">Buscar mis fotos</a>
          </nav>
        </>
      ) : (
        <div class="header__meta">
          <span class="header__location header__location--short">Mérida</span>
          <span class="header__location header__location--full">Mérida, Venezuela</span>
          <a class="header__cta" href="/#tu-evento">Buscar mis fotos</a>
        </div>
      )
    }
  </div>
</header>

<script>
  const homeHeader = document.querySelector<HTMLElement>("[data-home-header]");

  if (homeHeader) {
    const menuButton = homeHeader.querySelector<HTMLButtonElement>(".header__menu-button");
    const menuLabel = menuButton?.querySelector<HTMLElement>(".sr-only");
    const navigation = homeHeader.querySelector<HTMLElement>(".header__nav");
    const desktopQuery = window.matchMedia("(min-width: 721px)");

    const closeMenu = () => {
      menuButton?.setAttribute("aria-expanded", "false");
      if (menuLabel) menuLabel.textContent = "Abrir menú";
      navigation?.classList.remove("is-open");
    };

    menuButton?.addEventListener("click", () => {
      const willOpen = menuButton.getAttribute("aria-expanded") !== "true";

      menuButton.setAttribute("aria-expanded", String(willOpen));
      if (menuLabel) menuLabel.textContent = willOpen ? "Cerrar menú" : "Abrir menú";
      navigation?.classList.toggle("is-open", willOpen);
    });

    navigation?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
        closeMenu();
        menuButton.focus();
      }
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>

<style>
  .header {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--container-padding);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .header__wordmark {
    display: block;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .header__logo {
    width: 5.5rem;
    height: auto;
  }

  .header__wordmark:active {
    opacity: 0.72;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__location {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .header__location--full,
  .header__cta {
    display: none;
  }

  .header--home {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    background: rgb(244 244 242 / 94%);
    border-bottom-color: #dcdedb;
    backdrop-filter: blur(8px);
  }

  .header--home .header__inner {
    width: min(calc(100% - (2 * var(--content-gutter))), var(--content-max));
    min-height: var(--home-header-height);
    padding: 0;
    gap: 24px;
  }

  .header--home .header__logo {
    width: 5.5rem;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .header__nav > a:not(.header__home-cta) {
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .header__home-cta {
    display: inline-flex;
    min-height: var(--touch-target);
    align-items: center;
    justify-content: center;
    padding: 0.6875rem 1.125rem;
    background: var(--color-action);
    border: 2px solid var(--color-text);
    color: var(--color-text);
    font-size: 0.8rem;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .header__menu-button {
    display: none;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 10px;
    background: transparent;
    border: 1px solid var(--color-text);
    cursor: pointer;
  }

  .header__menu-button > span:not(.sr-only) {
    display: block;
    height: 2px;
    margin: 5px 0;
    background: var(--color-text);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .header__menu-button[aria-expanded="true"] > span:nth-of-type(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__menu-button[aria-expanded="true"] > span:nth-of-type(3) {
    opacity: 0;
  }

  .header__menu-button[aria-expanded="true"] > span:nth-of-type(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header__menu-button,
  .header__nav a {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .header__nav > a:not(.header__home-cta):active {
    color: var(--color-text-muted);
  }

  .header__menu-button:active,
  .header__home-cta:active {
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__nav > a:not(.header__home-cta):hover {
      color: var(--color-text-muted);
    }

    .header__home-cta:hover {
      background: var(--color-text);
      color: var(--color-accent);
    }
  }

  @media (min-width: 56.25rem) {
    .header__location--short {
      display: none;
    }

    .header__location--full,
    .header__cta {
      display: inline-block;
    }

    .header__cta {
      font-family: var(--font-family-display);
      font-weight: 800;
      font-size: var(--font-size-xs);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      text-decoration: none;
      background: var(--color-ink);
      color: var(--color-accent);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .header__logo {
      width: 6.25rem;
    }

    .header__cta:active {
      transform: translateY(1px);
    }
  }

  @media (min-width: 56.25rem) and (hover: hover) and (pointer: fine) {
    .header__cta:hover {
      background: var(--color-action);
      color: var(--color-action-text);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 45rem) {
    .header--home .header__logo {
      width: 4.75rem;
    }

    .header__menu-button {
      display: block;
    }

    .header__nav {
      position: fixed;
      inset: var(--home-header-height) 0 auto;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 16px;
      background: var(--color-surface-subtle);
      border-bottom: 1px solid var(--color-border);
    }

    .header__nav.is-open {
      display: flex;
    }

    .header__nav > a:not(.header__home-cta) {
      padding: 15px 4px;
      border-bottom: 1px solid var(--color-border);
    }

    .header__home-cta {
      margin-top: 16px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .header__menu-button > span:not(.sr-only),
    .header__home-cta,
    .header__home-cta:hover,
    .header__home-cta:active,
    .header__menu-button,
    .header__cta,
    .header__cta:hover,
    .header__cta:active {
      transition: none;
      transform: none;
    }
  }
</style>
