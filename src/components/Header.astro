---
import { Image } from "astro:assets";
import logo from "../assets/log.png";
---

<header class="header">
  <div class="header__inner">
    <a class="header__wordmark" href="/">
      <Image
        class="header__logo"
        src={logo}
        alt="Black Sheep Sport"
        width={264}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <div class="header__meta">
      <span class="header__location header__location--short">Mérida</span>
      <span class="header__location header__location--full">Mérida, Venezuela</span>
      <a class="header__cta" href="/#tu-evento">Buscar mis fotos</a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--container-padding);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .header__wordmark {
    display: block;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .header__logo {
    width: 5.5rem;
    height: auto;
  }

  .header__wordmark:active {
    opacity: 0.72;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__location {
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .header__location--full,
  .header__cta {
    display: none;
  }

  @media (min-width: 900px) {
    .header__location--short {
      display: none;
    }

    .header__location--full,
    .header__cta {
      display: inline-block;
    }

    .header__cta {
      font-family: var(--font-family-display);
      font-weight: 800;
      font-size: var(--font-size-xs);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      text-decoration: none;
      background: var(--color-ink);
      color: var(--color-accent);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

  }

  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .header__cta:hover {
      background: var(--color-accent);
      color: var(--color-accent-on);
      transform: translateY(-2px);
    }
  }

  @media (min-width: 900px) {
    .header__logo {
      width: 6.25rem;
    }

    .header__cta:active {
      transform: translateY(1px);
    }
  }
</style>
