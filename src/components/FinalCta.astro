---
const whatsappUrl =
  "https://wa.me/584247438483?text=Hola%2C%20vi%20mis%20fotos%20de%20HAPPY%20WOOD%20y%20me%20encantaron.%20Quiero%20comprar%20estas%20fotos%3A%20%5Bescribe%20aqu%C3%AD%20los%20c%C3%B3digos%5D.%20%C2%BFMe%20ayudas%20con%20el%20proceso%20de%20pago%3F";
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <h2 class="final-cta__headline" id="final-cta-title">¿Ya viste tus fotos?</h2>
  <p class="final-cta__subtitle">Envíanos tu nombre y los códigos por WhatsApp para completar tu compra.</p>
  <a class="final-cta__button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
    Comprar por WhatsApp
  </a>
</section>

<style>
  .final-cta {
    padding: var(--space-section-block) var(--container-padding);
    background: var(--color-ink);
    text-align: center;
  }

  .final-cta__headline {
    color: var(--color-ink-inverse);
    font-size: var(--font-size-2xl);
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
    margin-bottom: var(--space-3);
  }

  .final-cta__subtitle {
    max-width: var(--measure-prose);
    margin-inline: auto;
    font-size: var(--font-size-sm);
    color: var(--color-gray-300);
    margin-bottom: var(--space-6);
  }

  .final-cta__button {
    display: inline-block;
    text-decoration: none;
    font-family: var(--font-family-display);
    font-weight: 800;
    font-size: var(--font-size-sm);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-accent-on);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-sm);
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .final-cta__button:active {
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .final-cta__button:hover {
      /* Ya está en volt sobre fondo negro: invertir a ink+volt se perdería
         contra la sección. En vez de eso, pasa a blanco. */
      background: var(--color-surface);
      transform: translateY(-2px);
    }
  }

  @media (min-width: 900px) {
    .final-cta__button {
      padding: var(--space-4) var(--space-6);
    }
  }
</style>
