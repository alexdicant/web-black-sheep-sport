---
interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "¿Cómo encuentro mis fotos?",
    answer: "Busca tu evento y entra a la galería. Recorre las fotos y toca las que quieras añadir a tu selección.",
  },
  {
    question: "¿Cómo pago?",
    answer: "Cuando termines de seleccionar, pulsa «Comprar seleccionadas». Abriremos WhatsApp con los códigos de tus fotos listos para coordinar el pago por pago móvil o Binance.",
  },
  {
    question: "¿Cuándo estarán listas?",
    answer:
      "La galería se publica dentro de las 24 horas después de terminar el evento. Una vez confirmado el pago, recibes tus fotos al día siguiente.",
  },
  {
    question: "¿Cómo recibo las fotos?",
    answer: "Te las enviamos por WhatsApp como archivos, editadas, en alta resolución y sin marca de agua.",
  },
];
---

<section class="faq" id="preguntas" aria-labelledby="faq-title">
  <h2 class="faq__title" id="faq-title">Preguntas<br />frecuentes</h2>

  <div class="faq__list">
    {
      faqs.map((item, index) => (
        <details class="faq__item" open={index === 0}>
          <summary class="faq__question">{item.question}</summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 3rem;
    width: 100%;
    max-width: var(--content-max);
    padding-block: var(--section-space);
    padding-inline: var(--content-gutter);
    margin-inline: auto;
    color: var(--color-text);
  }

  .faq__title {
    font-family: "Archivo Variable", var(--font-family-display);
    font-size: clamp(1.875rem, 3.3vw, 2.75rem);
    font-stretch: 125%;
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .faq__list {
    min-width: 0;
    border-top: 2px solid currentColor;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__question {
    position: relative;
    min-height: 4.375rem;
    padding: 1.25rem 3.25rem 1.25rem 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::marker {
    content: "";
  }

  .faq__question::after {
    content: "+";
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    width: 1.875rem;
    height: 1.875rem;
    background: var(--color-surface);
    border: 1px solid currentColor;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1;
    place-items: center;
    transform: translateY(-50%);
  }

  .faq__item[open] .faq__question::after {
    content: "−";
    background: var(--color-action);
  }

  .faq__question:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .faq__answer {
    max-width: 64ch;
    margin: 0 3.25rem 1.375rem 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 56.25rem) {
    .faq {
      grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr);
      column-gap: var(--space-8);
    }
  }

  @media (max-width: 45rem) {
  }
</style>
