---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  canonical?: boolean;
  robots?: "noindex, follow" | "noindex, nofollow";
  home?: boolean;
}

const {
  title,
  description = "Fotografía deportiva en Mérida. Encuentra tus fotos del evento.",
  canonical = true,
  robots,
  home = false,
} = Astro.props;
const canonicalUrl = canonical ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImageUrl = new URL("/og-black-sheep-sport.png", Astro.site);
---

<!doctype html>
<html lang="es" class:list={{ "home-page": home }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Black Sheep Sport" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/webp" sizes="512x512" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-T78YKQN3QZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-T78YKQN3QZ');
    </script>

    {
      home ? (
        <link
          rel="preload"
          href="/fonts/archivo-variable-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      ) : (
        <>
          <link
            rel="preload"
            href="/fonts/instrument-sans-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/archivo-expanded-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }

    <title>{title}</title>

    <style is:global>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url("/fonts/instrument-sans-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: "Archivo Expanded";
        font-style: normal;
        font-weight: 400 900;
        font-stretch: 125%;
        font-display: swap;
        src: url("/fonts/archivo-expanded-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: "Archivo Variable";
        font-style: normal;
        font-weight: 400 900;
        font-stretch: 62% 125%;
        font-display: swap;
        src: url("/fonts/archivo-variable-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }

      /* Reset mínimo */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      html.home-page {
        --home-paper: #f4f4f2;
        --home-ink: #0d0f0e;
        --home-ink-soft: #2b2e2c;
        --home-muted: #4a4f4c;
        --home-line: #cfd3d0;
        --home-container: 1240px;
        --home-gutter: 24px;
        --home-header-height: 73px;
        --container-padding: var(--home-gutter);
        --container-max-width: calc(var(--home-container) + (2 * var(--container-padding)));
        --font-family-display: "Archivo Variable", sans-serif;
        --font-family-body: "Archivo Variable", sans-serif;
        scroll-behavior: smooth;
        scroll-padding-top: calc(var(--home-header-height) + 16px);
      }

      html.home-page body {
        background: var(--home-paper);
        color: var(--home-ink);
        font-family: "Archivo Variable", sans-serif;
        font-stretch: 100%;
        -webkit-font-smoothing: antialiased;
      }

      html.home-page :focus-visible {
        outline: 3px solid #6e8f00;
        outline-offset: 3px;
      }

      @media (max-width: 720px) {
        html.home-page {
          --home-gutter: 16px;
          --home-header-height: 65px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html.home-page {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--color-surface);
        color: var(--color-ink);
        font-family: var(--font-family-body);
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: var(--font-family-display);
        font-weight: 800;
        line-height: var(--line-height-tight);
      }

      p,
      figure,
      ul,
      ol {
        margin: 0;
      }

      ul,
      ol {
        padding: 0;
        list-style: none;
      }

      a,
      button {
        touch-action: manipulation;
      }

      img,
      svg {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      button {
        font: inherit;
        color: inherit;
      }

      ::selection {
        background: var(--color-accent);
        color: var(--color-accent-on);
      }

      :focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
