---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  canonical?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Fotografía deportiva en Mérida. Encuentra tus fotos del evento.",
  canonical = true,
  noindex = false,
} = Astro.props;
const canonicalUrl = canonical ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImageUrl = new URL("/og-black-sheep-sport.webp", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Black Sheep Sport" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/webp" sizes="512x512" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-T78YKQN3QZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-T78YKQN3QZ');
    </script>

    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/archivo-expanded-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>

    <style is:global>
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url("/fonts/instrument-sans-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: "Archivo Expanded";
        font-style: normal;
        font-weight: 400 900;
        font-stretch: 125%;
        font-display: swap;
        src: url("/fonts/archivo-expanded-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
          U+FEFF, U+FFFD;
      }

      /* Reset mínimo */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--color-surface);
        color: var(--color-ink);
        font-family: var(--font-family-body);
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: var(--font-family-display);
        font-weight: 800;
        line-height: var(--line-height-tight);
      }

      p,
      figure,
      ul,
      ol {
        margin: 0;
      }

      ul,
      ol {
        padding: 0;
        list-style: none;
      }

      a,
      button {
        touch-action: manipulation;
      }

      img,
      svg {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      button {
        font: inherit;
        color: inherit;
      }

      ::selection {
        background: var(--color-accent);
        color: var(--color-accent-on);
      }

      :focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
