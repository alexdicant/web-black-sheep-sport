---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Events from "../components/Events.astro";
import HowToBuy from "../components/HowToBuy.astro";
import Pricing from "../components/Pricing.astro";
import Gallery from "../components/Gallery.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Base
  title="Fotografía deportiva en Mérida | Black Sheep Sport"
  description="Fotografía deportiva profesional en Mérida, Venezuela. Encuentra las fotos de tu evento, elige tus favoritas y coordina la compra por WhatsApp."
>
  <Header />
  <main id="inicio">
    <Hero />
    <Events />
    <HowToBuy />
    <Pricing />
    <Gallery />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <BackToTop />
</Base>
