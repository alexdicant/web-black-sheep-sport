---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import EventGallery from "../../components/EventGallery.astro";
import Footer from "../../components/Footer.astro";
import BackToTop from "../../components/BackToTop.astro";
import { buildEventPhotos, type EventImageModule } from "../../utils/eventPhotos";
import {
  formatEventDate,
  getEventBySlug,
  getEventPageDescription,
  getEventPageTitle,
  getEventStorageKey,
} from "../../data/events";

const eventPhotoModules = import.meta.glob<EventImageModule>(
  "../../assets/events/happy-wod/*.{webp,jpg,jpeg,png,avif}",
  { eager: true },
);

const event = getEventBySlug("happy-wod");
const photos = buildEventPhotos(eventPhotoModules, event.name);
---

<Base
  title={getEventPageTitle(event)}
  description={getEventPageDescription(event)}
  robots="noindex, follow"
>
  <Header />
  <main id="main-content" tabindex="-1">
    <EventGallery
      eventName={event.name}
      venue={event.location}
      date={formatEventDate(event.isoDate)}
      isoDate={event.isoDate}
      photos={photos}
      storageKey={getEventStorageKey(event)}
    />
  </main>
  <Footer />
  <BackToTop />
</Base>
