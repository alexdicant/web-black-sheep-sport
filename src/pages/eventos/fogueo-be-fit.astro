---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import EventGallery from "../../components/EventGallery.astro";
import Footer from "../../components/Footer.astro";
import BackToTop from "../../components/BackToTop.astro";
import { buildEventPhotos, type EventImageModule } from "../../utils/eventPhotos";

const eventPhotoModules = import.meta.glob<EventImageModule>(
  "../../assets/events/fogueo-be-fit/*.{webp,jpg,jpeg,png,avif}",
  { eager: true },
);

const EVENT_NAME = "Fogueo Be Fit";
const photos = buildEventPhotos(eventPhotoModules, EVENT_NAME);
---

<Base
  title="Fogueo Be Fit | Black Sheep Sport"
  description="Galería de fotografías de Fogueo Be Fit. Encuentra y selecciona tus fotos del evento."
  robots="noindex, follow"
>
  <Header />
  <main>
    <EventGallery
      eventName="Fogueo Be Fit"
      venue="Be Fit Mérida"
      date="16 de octubre de 2025"
      isoDate="2025-10-16"
      photos={photos}
      storageKey="black-sheep-selection-fogueo-be-fit"
      whatsappNumber="584247438483"
    />
  </main>
  <Footer />
  <BackToTop />
</Base>
